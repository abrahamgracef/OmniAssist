# ====================================================================
# OmniAssist Environment Variables Configuration
# ====================================================================

# 1. Google Gemini API Key (Fast & Free)
# Get your free key instantly at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...your_gemini_key_here

# (Optional: If your friend wants to use Groq later)
# GROQ_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# 2. Google OAuth Credentials (for Gmail and Google Calendar login)
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:7337/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
